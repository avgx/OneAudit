    "AuditJournalMessage_AE_ALERT_FALSE": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení {device} ze serveru {host}: Alarm označen za falešný uživatelem {role}/{user} z IP adresy {ip_address}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät {device} von Server {host}: Als falsch eingestufter Alarm durch Benutzer {role}/{user} von IP-Adresse {ip_address}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device {device} of server {host}: Alarm classified as false by user {role}/{user} from IP address {ip_address}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerta clasificada como falsa en el dispositivo {device} del servidor {host}"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקן {device} בשרת {host}: אזעקה הוגדרה כאזעקת שווא על ידי משתמש  {role}/{user} מכתובת IP {ip_address}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー{device}のデバイス{host}:　アラームをエラーに分類"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 {host}의 장치 {device}: 잘못된 것으로 분류된 알람"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm sklasyfikowano jako fałszywy na urządzeniu {device} na serwerze {host}, użytkownik {role}/{user}, adres IP {ip_address}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme classificado como falso no dispositivo {device} do Servidor {host}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство {device} сервера {host}: Тревога классифицирована как ложная пользователем {role}/{user} с IP-адреса {ip_address}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Device {device} of server {host}: Alarm classified as false by user {role}/{user} from IP address {ip_address}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{host}伺服器的{device}設備 : 透過{role}/{user}使用者從{ip_address}IP地址將警報歸類成錯誤警報(誤報)(綠)"
          }
        }
      }
    },
