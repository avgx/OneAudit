    "AuditJournalMessage_AE_ALERT_MISSED": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeškaný alarm na zařízení {device} serveru {host} uživatelem {role}/{user} z IP adresy {ip_address}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm verpasst auf Gerät {device} von Server {host} durch Benutzer {role}/{user} von IP-Adresse {ip_address}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm missed on device {device} of server {host} by user {role}/{user} from IP adress {ip_address}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerta perdida en el dispositivo{device} del servidor {host}"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אזעקה הוחמצה בהתקן {device} של השרת {host} על ידי משתמש {role}/{user} מכתובת IP {ip_address}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームはサーバー{device}のデバイス{host}を逃しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 {host}의 장치 {device}에서 놓친 알람"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm bez reakcji operatora na urządzeniu {device} na serwerze {host}, użytkownik {role}/{user}, adres IP {ip_address}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme perdido no dispositivo {device} do servidor {host}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропущена тревога на устройстве {device} сервера {host} пользователем {role}/{user} с IP-адреса {ip_address}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm missed on device {device} of server {host} by user {role}/{user} from IP adress {ip_address}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "警報在{device}設備上遺失是從{role}/{user}使用者在{ip_address}IP地址上的{host}伺服器."
          }
        }
      }
    },
