    "AuditJournalMessage_AE_DETECTOR_ADD": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidána detekce {detector} zařízení {device} na serveru {host} uživatelem {role}/{user} z IP adresy {ip_address}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen der Erkennung {detector} von Gerät {device} auf Server {host} durch Benutzer {role}/{user} von IP-Adresse {ip_address}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding detection {detector} of device {device} on server {host} by user {role}/{user} from IP address {ip_address}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar detector {detector} del dispositivo {device} en el servidor {host}"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גלאי {detector} של התקן {device} נוסף לשרת {host} על ידי משתמש {role}/{user} מכתובת IP {ip_address}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー{detector}上のデバイス{device}の追加された検出{host}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 {host}의 장치 {device}에 감지 {detector} 추가"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano detekcję {detector} na urządzeniu {device} na serwerze {host}, użytkownik {role}/{user}, adres IP {ip_address}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecção {detector} do dispositivo {device} adicionada ao servidor {host}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление детектора {detector} устройства {device} на сервере {host} пользователем {role}/{user} с IP-адреса {ip_address}"
          }
        },
        "zh-Hans": {
